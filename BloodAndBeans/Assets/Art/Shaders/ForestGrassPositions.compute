#pragma kernel CSMain

// 밤 숲 바닥의 풀 위치를 GPU에서 뽑는다.
//
// 원본: Youssef-Afella/UnityURP-InfiniteGrass (MIT) 의 GrassPositionsCompute.compute.
// 원본은 무한 지형용이라 매 프레임 위에서 내려다본 높이·마스크 텍스처를 굽고 그것을 샘플한다.
// 그 텍스처를 굽는 Renderer Feature가 URP 14 API(Execute/ConfigureTarget)를 쓰는데 우리
// URP 17.5에는 그 메서드가 아예 없다. 그리고 우리 맵은 **고정된 평평한 사각형**이라
// 높이도 경사도 상수다 — 매 프레임 구울 것이 없다.
//
// 그래서 높이 텍스처를 지우고 지면 높이를 상수로, 생성 범위를 월드 사각형으로 바꿨다.
// 서드파티 원본은 손대지 않고 프로젝트 소유 복사본을 둔다 (AGENTS.md).
//
// 남긴 것: 해시 난수 배치, 거리별 밀도 감소, 절두체 컬링. 원본의 핵심이 이 셋이다.

float _Spacing;
float _DrawDistance;
float _FullDensityDistance;

int2 _GridStartIndex;

/// 지면 높이. 중력이 없어서(PlayerMove) 이 값이 어긋나면 풀이 공중에 뜬 채로 남는다.
float _GroundY;

/// 풀이 자랄 월드 사각형. 숲 지면과 같아야 한다.
float2 _MapMin;
float2 _MapSize;

float3 _CameraPosition;
float4x4 _VPMatrix;

/// 밀도 마스크(R). 0이면 가득, 1이면 없음. 길·빈터를 파고 싶을 때 쓴다.
/// 쓰지 않을 때는 검은 1x1 텍스처가 물리므로 전면 밀도가 된다.
Texture2D<float> _GrassMask;
SamplerState linearClampSampler;

AppendStructuredBuffer<float3> _GrassPositions;

uint murmurHash3(int input)
{
    uint h = abs(input);
    h ^= h >> 16;
    h *= 0x85ebca6b;
    h ^= h >> 13;
    h *= 0xc2b2ae3d;
    h ^= h >> 16;
    return h;
}

float random(int index)
{
    return murmurHash3(index) / 4294967295.0;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    int2 currentIndex = _GridStartIndex + id.xy;

    float2 positionXZ = currentIndex * _Spacing;

    // 격자 티가 나지 않게 칸 안에서 흔든다.
    float2 randomOffset = float2(random(currentIndex.x * 5542 + currentIndex.y),
                                 random(currentIndex.y * 9824 + currentIndex.x));
    positionXZ += (randomOffset * 2 - 1) * _Spacing;

    // 맵 밖에는 심지 않는다. 지면이 없는 곳에 풀만 떠 있게 된다.
    float2 uv = (positionXZ - _MapMin) / _MapSize;
    if (any(uv < 0.0) || any(uv > 1.0)) return;

    // 마스크는 밀도다. 난수가 마스크 값보다 크거나 같아야 심는다 —
    // 마스크 0이면 항상 통과(가득), 1이면 절대 통과하지 못한다(없음).
    float maskValue = _GrassMask.SampleLevel(linearClampSampler, uv, 0).r;
    if (saturate(random(currentIndex.x * 9421 + currentIndex.y) - 0.001) < maskValue) return;

    float3 positionWS = float3(positionXZ.x, _GroundY, positionXZ.y);

    // 멀수록 솎아낸다. _FullDensityDistance마다 밀도가 절반이 된다.
    float distanceFromCamera = length(_CameraPosition - positionWS);
    uint d = uint(floor(distanceFromCamera / _FullDensityDistance));
    d = 1 << d;
    if (murmurHash3(currentIndex.x + currentIndex.y * 7954) % d != 0) return;

    // 절두체 컬링. 클립 공간에서 바로 본다.
    float4 absPosCS = abs(mul(_VPMatrix, float4(positionWS, 1.0)));
    if (absPosCS.z <= absPosCS.w && absPosCS.y <= absPosCS.w * 1.5
        && absPosCS.x <= absPosCS.w * 1.1 && absPosCS.w <= _DrawDistance)
    {
        _GrassPositions.Append(positionWS);
    }
}
